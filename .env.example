# ================================
# APP
# ================================
PORT=3000
NODE_ENV=development

# ================================
# DATABASE - PostgreSQL
# DB_SYNCHRONIZE=true khi dev (tự tạo bảng), false khi production (dùng migration)
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ecom_user
DB_PASSWORD=ecom_password
DB_DATABASE=ecommerce
DB_SYNCHRONIZE=true
DB_LOGGING=true

# ================================
# CACHE - Redis
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_TTL=60

# ================================
# SEARCH - Elasticsearch
# ================================
ELASTICSEARCH_NODE=http://localhost:9200

# ================================
# NestJS Observe (APM)
# ================================
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
